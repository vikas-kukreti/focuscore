<Window
    x:Class="FocusCore.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FocusCore.WinUI"
    Title="FocusCore"
    Width="1140"
    Height="720">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Pomodoro timer bar (accent) -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Background="{StaticResource AccentBrush}" Margin="0" Padding="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock x:Name="TimerText" Text="00:00" Foreground="White"
                           FontSize="40" FontWeight="Bold" />
                <TextBlock x:Name="TimerTask" Text="No active timer" Foreground="White"
                           Opacity="0.9" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Pomodoro (25:00)" Foreground="White" Opacity="0.9"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="BtnStartStop" Content="Start" Click="OnTimerStartStop" />
                <Button x:Name="BtnPause" Content="Pause" Click="OnTimerPause" />
                <Button x:Name="BtnStop" Content="Stop" Click="OnTimerStop" />
            </StackPanel>
        </Grid>

        <!-- Today's task list -->
        <ListView x:Name="TaskList" Grid.Row="1" Grid.Column="0" Margin="12,12,6,12"
                  SelectionChanged="OnTaskSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding Done, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Timebox slots 06:00–23:00 -->
        <ListView x:Name="TimeboxList" Grid.Row="1" Grid.Column="1" Margin="6,12,6,12"
                  IsItemClickEnabled="True" ItemClick="OnTimeboxSlotClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TaskTitle}" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Opacity="0.8" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Task detail pane -->
        <Grid x:Name="DetailPane" Grid.Row="1" Grid.Column="2" Margin="6,12,12,12"
              Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock Text="Task details" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox x:Name="DetailTitle" Header="Title" />
                <CheckBox x:Name="DetailDone" Content="Done" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox x:Name="DetailHour" Header="Timebox start" Width="120" />
                    <ComboBox x:Name="DetailDuration" Header="Duration (min)" Width="140" />
                    <Button Content="Apply timebox" Click="OnApplyTimebox" />
                </StackPanel>
                <Button x:Name="BtnMarkDone" Content="Mark done" Click="OnMarkDone" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>