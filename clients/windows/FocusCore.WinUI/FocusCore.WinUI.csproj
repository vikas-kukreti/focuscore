<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <AssemblyName>FocusCore</AssemblyName>
    <RootNamespace>FocusCore.WinUI</RootNamespace>
    <EnablePreviewMsixTooling>false</EnablePreviewMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableXamlDiagnostics>false</EnableXamlDiagnostics>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="focuscore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240627000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <!-- Toast content building (paired with Windows.AppNotifications from the App SDK). -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- System Tray / NotifyIcon helper for WinUI (listed; tray in this build is implemented
         directly via Shell_NotifyIcon on a hidden message window per the PRD). -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.0.116" />
  </ItemGroup>

</Project>
